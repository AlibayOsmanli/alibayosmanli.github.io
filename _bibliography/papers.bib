@article{osmanli2026placetally,
  bibtex_show={true},
  abbr={arXiv},
  title={PlaceTally: A Test-Time Memory Model for Constructing Place Graphs},
  author={Osmanli, Alibay and Gong, Shaogang},
  journal={arXiv preprint arXiv:2611.22608},
  year={2026},
  month={nov},
  arxiv={2611.22608},
  pdf={https://arxiv.org/pdf/2611.22608},
  website={https://alibayosmanli.github.io/placetally},
  code={https://github.com/AlibayOsmanli/placetally},
  supp={https://alibayosmanli.github.io/placetally/supplement.pdf},
  preview={placetally.png},
  abstract={Counting distinct objects in a video is hard when the camera returns to places it has already seen. PlaceTally is a question-blind test-time memory model that builds a place graph for each video before any question is asked: each video fragment joins the place of its best earlier match or opens a new place. A frozen vision-language model then counts each place once from a bounded number of frames. On RevisitCount, our benchmark of real room re-recordings, PlaceTally outperforms the same model reading the whole video on test and held-out rooms, and stays level as rooms return more or less often.},
  selected={true}
}

@article{osmanli2026ovetconsensus,
  bibtex_show={true},
  abbr={arXiv},
  title={OVET-Consensus: Rank-Preserving Counterfactual Event Verification for Video Moment Grounding},
  author={Osmanli, Alibay and Gong, Shaogang},
  journal={arXiv preprint arXiv:2611.22637},
  year={2026},
  month={nov},
  arxiv={2611.22637},
  pdf={https://arxiv.org/pdf/2611.22637},
  preview={ovet_consensus.png},
  abstract={Video moment retrieval systems often propose a window that overlaps the target event, yet still select the wrong one. OVET-Consensus is a rank-preserving verification layer: it keeps a strong temporal expert's ranked list as the default and allows a rank-1 override only when interval, vision-language and dense temporal evidence agree. On QVHighlights validation it gives a small top-1 gain with 20 overrides, 15 of them helpful, and shows that a large oracle gap does not make semantic reranking easy.},
  selected={true}
}

